# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Port
PORT=3000

# Node Environment (development | production)
NODE_ENV=development

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/reasons_db

# JWT Secret Key (use a strong random string in production)
JWT_SECRET=reasons_secret_key_2026_uta

# CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:4200

# Frontend URL for password recovery links
FRONTEND_URL=http://localhost:4200

# Reset password token expiration time in minutes
RESET_TOKEN_TTL_MINUTES=15

# Maximum recovery requests allowed within the time window
FORGOT_PASSWORD_MAX_ATTEMPTS=3
FORGOT_PASSWORD_WINDOW_MINUTES=15

# SMTP configuration for Nodemailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@example.com
SMTP_PASS=super_secret_password
MAIL_FROM="REASONS <no-reply@example.com>"
